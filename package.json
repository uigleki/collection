{
  "name": "collection",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test a11y",
    "test:visual": "playwright test visual",
    "lighthouse": "pnpm run build && lhci autorun",
    "fonts:cjk": "node scripts/subset-cjk.ts"
  },
  "dependencies": {
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "motion": "^14.11.1",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "//": "@playwright/test is pinned to its minor version because the browsers come from nixpkgs (playwright-driver.browsers in flake.nix, version fixed by flake.lock). Each Playwright minor needs the browser builds of its own release, and with a mismatched minor every e2e run fails at launch. Update it together with nixpkgs.",
  "//biome": "@biomejs/biome is pinned to the exact version nixpkgs provides to the pre-commit hook. Biome runs from nix before a commit and from pnpm in CI; if the two versions differ they format differently, and one of the two checks fails. Update it together with nixpkgs.",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.4",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "~1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "mdast-util-from-markdown": "^2.1.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.5",
    "thumbhash": "^0.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "license": "AGPL-3.0-only"
}
