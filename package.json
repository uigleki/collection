{
  "name": "collection",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test a11y",
    "test:visual": "playwright test visual",
    "lighthouse": "vite build && lhci autorun",
    "fonts:cjk": "bun scripts/subset-cjk.ts"
  },
  "dependencies": {
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "lenis": "^1.3.25",
    "motion": "^12.42.2",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "//": "@playwright/test is held to its minor: the browsers come from nixpkgs (flake.nix pins playwright-driver.browsers, chromium build 1228) and a minor bump expects a build nix does not have, which fails every e2e run at launch. Move it when nixpkgs moves.",
  "//biome": "@biomejs/biome is held to an exact version, the one nixpkgs gives the pre-commit hook. Two installers reach for this linter — nix before a commit, bun in CI — and a linter that disagrees with itself between them would reformat on every commit and fail the gate it just passed. Move it when nixpkgs moves.",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "~1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "axe-core": "^4.12.1",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.3.3",
    "thumbhash": "^0.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "license": "AGPL-3.0-only"
}
